# The frontend talks to mini_app_api.py directly via an absolute URL --
# they run as separate processes on separate ports (see vite.config.ts
# and start_mini_app.py), there is no dev-server proxy for /api/*.
# Set this to the backend's URL; for local dev with start_mini_app.py
# that's http://localhost:8000, in production it's wherever
# mini_app_api.py is actually reachable (e.g. behind the ngrok tunnel).
VITE_API_BASE_URL=
