# Defaults to '' (relative/same-origin) -- correct for the project's
# actual deployment path via start_mini_app.py, where mini_app_api.py
# builds and serves this frontend itself as static files (see
# MINI_APP_STATIC_DIR in the root .env.example) on the same origin as
# its own API. Leave this blank/unset unless you are intentionally
# running `npm run dev` as a separate process against a
# different-origin backend, in which case set it to that backend's URL
# (e.g. http://localhost:8000).
VITE_API_BASE_URL=
