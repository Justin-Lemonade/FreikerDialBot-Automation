TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADMIN_TELEGRAM_USER_IDS=

# Telegram Mini App
# Set this to the HTTPS URL where the frontend is served (e.g. ngrok URL)
# MINI_APP_URL=https://your-ngrok-url.ngrok-free.app
# MINI_APP_AUTH_MAX_AGE_SECONDS=86400

# Directory containing the built frontend (frontend/dist after `npm run
# build`) that mini_app_api.py serves as static files -- this is what
# lets one process/origin serve both the Mini App UI and its API. Set
# automatically by start_mini_app.py; only needed manually if running
# mini_app_api.py directly without that launcher.
# MINI_APP_STATIC_DIR=frontend/dist

# Off by default. Every /api endpoint (except the static frontend itself)
# requires a valid Authorization: tma <initData> header -- set this to 1
# ONLY for local browser testing outside a real Telegram client, where no
# initData exists at all. Do not set this in any real deployment.
# MINI_APP_ALLOW_ANONYMOUS=1

GEMINI_API_KEY=
GEMINI_MODEL=

GITHUB_TOKEN=
GITHUB_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
